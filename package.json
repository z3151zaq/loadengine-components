{
  "name": "le-components",
  "version": "1.0.0",
  "description": "A workspace for copyable UI components and their documentation.",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --filter docs dev",
    "build": "pnpm --filter docs build",
    "build:ui": "pnpm --filter @le-components/ui build",
    "build:all": "pnpm run build:ui && pnpm --filter docs build",
    "lint": "pnpm --filter docs lint",
    "typecheck": "pnpm --filter docs typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  }
}
