{
  "name": "le-components",
  "version": "1.0.0",
  "description": "A workspace for copyable UI components and their documentation.",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --filter docs dev & pnpm --filter docs storybook",
    "dev:docs": "pnpm --filter docs dev",
    "dev:storybook": "pnpm --filter docs storybook",
    "build": "pnpm run build:ui && pnpm --filter docs build && pnpm --filter docs build-storybook",
    "build:docs": "pnpm --filter docs build",
    "build:ui": "pnpm --filter @xxnnyy/ui build",
    "build:storybook": "pnpm --filter docs build-storybook",
    "build:all": "pnpm run build",
    "lint": "pnpm --filter docs lint",
    "typecheck": "pnpm --filter docs typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  }
}
