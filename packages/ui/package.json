{
  "name": "@le-components/ui",
  "version": "0.1.0",
  "description": "Copyable and composable React UI components built with Radix UI and Tailwind CSS.",
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:js": "tsup src/index.ts --format esm,cjs --dts --external react --clean",
    "build:css": "tailwindcss -i src/styles/global.css -o dist/styles.css --minify",
    "build": "pnpm run clean && pnpm run build:js && pnpm run build:css",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18 || ^19",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
