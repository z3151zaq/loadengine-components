{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "noEmit": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.stories.tsx"
  ]
}
